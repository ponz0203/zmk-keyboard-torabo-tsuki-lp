#include <behaviors/hires_dial.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        windows {
            bindings = <
&trans  &trans      &trans    &trans    &trans  &trans                                                       &trans       &trans  &trans     &trans     &trans       &trans
&trans  &kp Q       &kp W     &kp E     &kp R   &kp T                                                        &kp Y        &kp U   &kp I      &kp O      &kp P        &trans
&trans  &kp A       &kp S     &kp D     &kp F   &kp G                 &trans                     &trans      &kp H        &kp J   &kp K      &kp L      &lt 1 ENTER  &trans
&trans  &kp Z       &kp X     &kp C     &kp V   &kp B                 &mt LEFT_COMMAND UP_ARROW  &lt 8 TAB   &kp N        &kp M   &kp COMMA  &kp DOT    &lt 7 MINUS  &trans
&trans  &kp ESCAPE  &kp LGUI  &kp LALT  &trans  &mt LEFT_SHIFT SPACE  &mt LCTRL UP_ARROW         &lt 6 LEFT  &lt 5 RIGHT  &trans  &trans     &kp PSCRN  &kp ESCAPE   &trans
            >;

            sensor-bindings = <&hires_dial_scroll 1 1>;
        };

        winmouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans                     &trans           &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &mt RC(KP_MINUS) RC(PLUS)  &kp RC(RS(TAB))  &msc SCRL_UP    &kp RC(TAB)      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mt RC(RS(Z)) LC(Z)        &mkp LCLK        &mkp MCLK       &mkp RCLK        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RC(T)  &kp RC(W)                  &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(C)  &mt RG(V) RC(V)            &trans           &trans          &kp LC(R)        &trans  &trans
            >;

            sensor-bindings = <&hires_dial_scroll 10 1>;
        };

        IOS {
            bindings = <
&trans  &trans      &trans    &trans    &trans  &trans                                                       &trans       &trans  &trans     &trans             &trans       &trans
&trans  &kp Q       &kp W     &kp E     &kp R   &kp T                                                        &kp Y        &kp U   &kp I      &kp O              &kp P        &trans
&trans  &kp A       &kp S     &kp D     &kp F   &kp G                 &trans                     &trans      &kp H        &kp J   &kp K      &kp L              &lt 1 ENTER  &trans
&trans  &kp Z       &kp X     &kp C     &kp V   &kp B                 &mt LEFT_CONTROL UP_ARROW  &lt 8 TAB   &kp N        &kp M   &kp COMMA  &kp DOT            &lt 7 MINUS  &trans
&trans  &kp ESCAPE  &kp LGUI  &kp LALT  &trans  &mt LEFT_SHIFT SPACE  &mt LCTRL UP_ARROW         &lt 6 LEFT  &lt 5 RIGHT  &trans  &trans     &kp RS(RG(KP_N5))  &kp ESCAPE   &trans
            >;

            sensor-bindings = <&hires_dial_scroll 1 1>;
        };

        IOSMOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans                  &trans           &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &mt RG(MINUS) RG(PLUS)  &kp RC(RS(TAB))  &msc SCRL_UP    &kp RC(TAB)      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mt RG(RS(Z)) RG(Z)     &mkp LCLK        &mkp MCLK       &mkp RCLK        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RG(T)  &kp RG(W)               &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RG(C)  &kp RG(V)               &trans           &trans          &kp RG(R)        &trans  &trans
            >;

            sensor-bindings = <&hires_dial_scroll 10 1>;
        };

        NUMBER {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans               &trans        &trans        &trans         &trans              &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &mt MINUS PLUS       &kp N7        &kp N8        &kp N9         &kp DELETE          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mt SEMICOLON COLON  &kp NUMBER_4  &kp N5        &kp NUMBER_6   &kp BACKSPACE       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp EQUAL  &kp RG(N0)           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &mt ASTERISK SLASH  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans               &trans        &trans        &mt COMMA DOT  &kp ESCAPE          &trans
            >;

            sensor-bindings = <&hires_dial_scroll 10 1>;
        };

        SYMBOL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans       &trans                             &trans                               &trans                    &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans       &trans                             &trans                               &trans                    &kp DELETE     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp AT_SIGN  &mt LEFT_BRACKET LEFT_PARENTHESIS  &mt RIGHT_BRACKET RIGHT_PARENTHESIS  &mt SEMICOLON COLON       &kp BACKSPACE  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp GRAVE    &kp DQT                            &kp UNDER                            &mt EXCLAMATION QUESTION  &kp SLASH      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans                             &trans                               &trans                    &trans         &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
